{
  "name": "resonance",
  "version": "1.0.0",
  "description": "Real-time 24-instrument audio visualizer and media player",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/resonance-hz/resonance-hz.github.io.git"
  },
  "keywords": [
    "music",
    "audio",
    "visualizer",
    "player",
    "vlc"
  ],
  "author": "OswanYunus",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.1"
  },
  "build": {
    "appId": "com.oswanyunus.resonance",
    "productName": "Resonance",
    "copyright": "Copyright © 2026 Oswan Yunus",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "icon.ico",
      "fileAssociations": [
        {
          "ext": "mp3",
          "name": "MP3 Audio",
          "role": "Viewer"
        },
        {
          "ext": "flac",
          "name": "FLAC Audio",
          "role": "Viewer"
        },
        {
          "ext": "m4a",
          "name": "M4A Audio",
          "role": "Viewer"
        },
        {
          "ext": "wav",
          "name": "WAV Audio",
          "role": "Viewer"
        },
        {
          "ext": "ogg",
          "name": "OGG Audio",
          "role": "Viewer"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Resonance",
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "deleteAppDataOnUninstall": false
    }
  }
}
